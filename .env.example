# MongoDB Atlas App Services Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Setup steps:
#   1. Create a free cluster at https://cloud.mongodb.com
#   2. Go to App Services (formerly Realm) → Create a new App
#   3. Enable Email/Password Authentication (set "User Confirmation" to "Automatically confirm users")
#   4. Create a MongoDB Data Source named "mongodb-atlas" and link your cluster
#   5. Set Collection Rules to allow read/write for authenticated users
#   6. Copy your App ID from the App Services dashboard

VITE_MONGODB_APP_ID=your-app-id-here

# Optional: override the default database name (default: manufacturing_pro)
# VITE_MONGODB_DB_NAME=manufacturing_pro

# ──────────────────────────────────────────────────────────────────────────────
# When VITE_MONGODB_APP_ID is not set, the app runs in offline mode using
# localStorage (all data stays in the browser — no account needed).
# ──────────────────────────────────────────────────────────────────────────────

# Example:
# VITE_MONGODB_APP_ID=manufacturingpro-abcde
